<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>

<StackPane fx:id="root" xmlns:fx="http://javafx.com/fxml"
           fx:controller="Gestion.controllers.MainController"
           stylesheets="@../css/modern-style.css">
    
    <VBox spacing="20" alignment="TOP_CENTER">
        <!-- Top Bar -->
        <HBox spacing="10" styleClass="top-bar" alignment="CENTER_RIGHT">
            <padding>
                <Insets top="10" right="20" bottom="10" left="20"/>
            </padding>
            <Label text="Formation Management " styleClass="app-title"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button text="À propos" styleClass="button">
                <graphic>
                    <FontAwesomeIconView glyphName="INFO_CIRCLE" size="16" fill="WHITE"/>
                </graphic>
            </Button>
            <Button text="Quitter" onAction="#handleExit" styleClass="button">
                <graphic>
                    <FontAwesomeIconView glyphName="SIGN_OUT" size="16" fill="WHITE"/>
                </graphic>
            </Button>
        </HBox>

        <VBox spacing="20" alignment="TOP_CENTER">
            <padding>
                <Insets top="20" right="30" bottom="20" left="30"/>
            </padding>

            <!-- Title -->
            <Label text="Système de Gestion des Formations " styleClass="page-title"/>

            <!-- Action Buttons -->
            <HBox spacing="20" alignment="CENTER">
                <Button text="Ajouter une Formation" 
                          onAction="#showAddFormationView" 
                          styleClass="button-green">
                    <graphic>
                        <FontAwesomeIconView glyphName="PLUS_CIRCLE" size="16" fill="WHITE"/>
                    </graphic>
                </Button>
                <Button text="GÉRER LES PARTICIPANTS" 
                          onAction="#showManageParticipantsView"
                          styleClass="button">
                    <graphic>
                        <FontAwesomeIconView glyphName="USERS" size="20" fill="WHITE"/>
                    </graphic>
                </Button>
            </HBox>
            
            <!-- Search Box -->
            <HBox spacing="10" alignment="CENTER">
                <TextField fx:id="searchField" promptText="Rechercher une formation..." prefWidth="300" />
                <Button text="Rechercher" 
                        onAction="#searchFormations" 
                        styleClass="button">
                    <graphic>
                        <FontAwesomeIconView glyphName="SEARCH" size="16" fill="WHITE"/>
                    </graphic>
                </Button>
                <Button text="Réinitialiser" 
                        onAction="#refreshCards" 
                        styleClass="button">
                    <graphic>
                        <FontAwesomeIconView glyphName="REFRESH" size="16" fill="WHITE"/>
                    </graphic>
                </Button>
            </HBox>

            <!-- Cards Container -->
            <VBox styleClass="card" VBox.vgrow="ALWAYS">
                <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS" styleClass="transparent-scroll-pane">
                    <FlowPane fx:id="formationsContainer" hgap="20" vgap="20" alignment="CENTER" styleClass="formations-flow-pane">
                        <padding>
                            <Insets top="15" right="15" bottom="15" left="15"/>
                        </padding>
                    </FlowPane>
                </ScrollPane>
                
                <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="table-actions">
                    <padding>
                        <Insets top="10" right="10" bottom="10" left="10"/>
                    </padding>
                    <Button text="Actualiser" 
                              onAction="#refreshCards" 
                              styleClass="button">
                        <graphic>
                            <FontAwesomeIconView glyphName="REFRESH" size="16"/>
                        </graphic>
                    </Button>
                </HBox>
            </VBox>
        </VBox>

        <!-- Status Bar -->
        <HBox styleClass="status-bar">
            <padding>
                <Insets top="5" right="10" bottom="5" left="10"/>
            </padding>
            <Label fx:id="statusLabel" text="Prêt - Updated" styleClass="status-label"/>
        </HBox>
    </VBox>
</StackPane> 