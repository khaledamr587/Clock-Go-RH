<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #1a334c;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.BulletinController">
   <children>
      <Label layoutX="230.0" layoutY="21.0" text="Bulletins de Paie" textFill="#ee8913">
         <font>
            <Font name="System Bold" size="30.0" />
         </font>
      </Label>
      <VBox alignment="CENTER" layoutX="50.0" layoutY="80.0" prefHeight="500.0" prefWidth="700.0" spacing="20.0">
         <children>
            <HBox alignment="CENTER" prefHeight="60.0" prefWidth="700.0" spacing="20.0">
               <children>
                  <Label text="Sélectionner un employé:" textFill="WHITE">
                     <font>
                        <Font size="16.0" />
                     </font>
                  </Label>
                  <ComboBox fx:id="comboSalaire" prefHeight="30.0" prefWidth="300.0" promptText="Choisir un salaire" />
                  <Button fx:id="btnGenerer" mnemonicParsing="false" onAction="#handleGenerer" prefHeight="40.0" prefWidth="150.0" style="-fx-background-color: #ee8913;" text="Générer bulletin" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Button>
               </children>
            </HBox>
            <TextArea fx:id="txtBulletin" editable="false" prefHeight="350.0" prefWidth="700.0" style="-fx-background-color: #f0f0f0; -fx-font-family: monospace;" wrapText="true">
               <font>
                  <Font size="14.0" />
               </font>
            </TextArea>
            <HBox alignment="CENTER" prefHeight="60.0" prefWidth="700.0" spacing="20.0">
               <children>
                  <Button fx:id="btnExporterExcel" mnemonicParsing="false" onAction="#handleExporterExcel" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: #2e7d32;" text="Exporter en Excel" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Button>
                  <Button fx:id="btnRetour" mnemonicParsing="false" onAction="#handleRetour" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: #333333;" text="Retour" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Button>
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </children>
</AnchorPane> 