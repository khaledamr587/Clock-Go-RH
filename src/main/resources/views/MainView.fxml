<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #1a334c;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.MainController">
   <children>
      <Label layoutX="272.0" layoutY="62.0" text="Gestion de Paie" textFill="#ee8913">
         <font>
            <Font name="System Bold" size="36.0" />
         </font>
      </Label>
      <VBox alignment="CENTER" layoutX="250.0" layoutY="180.0" prefHeight="240.0" prefWidth="300.0" spacing="20.0">
         <children>
            <Button fx:id="btnSalaires" mnemonicParsing="false" onAction="#handleSalaires" prefHeight="60.0" prefWidth="250.0" style="-fx-background-color: #ee8913;" text="Gestion des Salaires" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Button>
            <Button fx:id="btnPrimes" mnemonicParsing="false" onAction="#handlePrimes" prefHeight="60.0" prefWidth="250.0" style="-fx-background-color: #ee8913;" text="Gestion des Primes" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Button>
            <Button fx:id="btnBulletins" mnemonicParsing="false" onAction="#handleBulletins" prefHeight="60.0" prefWidth="250.0" style="-fx-background-color: #ee8913;" text="Bulletins de Paie" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Button>
            <Button fx:id="btnStatistiques" mnemonicParsing="false" onAction="#handleStatistiques" prefHeight="60.0" prefWidth="250.0" style="-fx-background-color: #ee8913;" text="Statistiques" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Button>
         </children>
      </VBox>
   </children>
</AnchorPane> 