<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="controllers.PageAccueil">
    <stylesheets>
        <URL value="@css/unified_styles.css" />
    </stylesheets>
    
    <children>
        <Label layoutX="20.0" layoutY="20.0" styleClass="title-main" text="Gestion des Recrutements" />
        
        <VBox layoutX="20.0" layoutY="60.0" spacing="15">
            <Button onAction="#ouvrirPageOffres" text="Gérer les offres" styleClass="button-common" prefWidth="200" />
            <Button onAction="#ouvrirPageCandidatures" text="Gérer les candidatures" styleClass="button-common" prefWidth="200" />
        </VBox>
        
        <VBox layoutX="350.0" layoutY="60.0" spacing="15">
            <Button mnemonicParsing="false" onAction="#candidatparidoffre" text="Candidat par id-offre" styleClass="button-right" prefWidth="200" />
            <Button mnemonicParsing="false" onAction="#OffreparIDcandidat" text="Offre par id-candidat" styleClass="button-right" prefWidth="200" />
        </VBox>
        
        <Button layoutX="20.0" layoutY="345.0" mnemonicParsing="false" onAction="#retourAdmin" text="Retour au tableau de bord" styleClass="button" />
    </children>
</AnchorPane>
